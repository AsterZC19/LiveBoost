# ===== LiveBoost 配置模板 =====

# Discord 机器人令牌（必填），https://discord.com/developers/applications
DISCORD_TOKEN=你的bot_token

# 命令注册目标服务器 ID；填了则只注册到该服务器，留空注册为全局命令
GUILD_ID=

# 无活动时的检测间隔（分钟），默认 2
CHECK_INTERVAL_MINUTES=2

# 是否启用时速推送，默认 true
HOURLY_PUSH_ENABLED=true

# Bestdori 服务器，默认 jp
BESTDORI_SERVER=jp

# 时间显示时区，默认 Asia/Tokyo
TIMEZONE=Asia/Tokyo

# /push 命令是否仅管理员可用，默认 true
REQUIRE_ADMIN=true

# state.json 路径（默认项目根目录；Docker 部署可外置到卷挂载目录，如 /data/state.json）
STATE_FILE=

# ===== 语音 TTS + AI 中日互译 =====

# bot 拥有者 Discord 用户 ID（必填）
BOT_OWNER_ID=

# OpenAI 兼容接口地址（默认 DeepSeek；可换成 Moonshot/OpenAI 等兼容服务）
AI_BASE_URL=https://api.deepseek.com/v1

# AI 翻译/语种识别 key（必填）
AI_API_KEY=

# AI 模型名，默认 deepseek-chat
AI_MODEL=deepseek-chat

# AI 推理力度：none=关闭思考（最快）；low/medium/high 逐级；留空（默认）则不传该参数
# 注意：换用 OpenAI/Moonshot 等不认 reasoning_effort 参数的服务时务必留空，否则请求会被 400 拒绝
AI_REASONING_EFFORT=

# TTS 音色（Edge TTS，免费）：中文 / 日文
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
TTS_VOICE_JA=ja-JP-NanamiNeural

# TTS 语速（SSML rate，+25% = 加快 25%；-10% = 放慢 10%）
TTS_RATE=+25%

# 最多同时并行服务的服务器数（默认 3，超出后拒绝新服务器加入）
MAX_VOICE_GUILDS=3

