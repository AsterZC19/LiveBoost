# ===== LiveBoost 配置模板 =====
# 复制为 .env 并填入真实值；.env 已被 gitignore，不会上传到 GitHub

# Discord 机器人令牌（必填），https://discord.com/developers/applications
DISCORD_TOKEN=你的bot_token

# 命令注册目标服务器 ID；填了则只注册到该服务器（即时生效），留空注册为全局命令（最多 1 小时后生效）
GUILD_ID=

# 无活动时的检测间隔（分钟），默认 2
CHECK_INTERVAL_MINUTES=2

# 是否启用时速推送，默认 true
HOURLY_PUSH_ENABLED=true

# Bestdori 服务器，默认 jp
BESTDORI_SERVER=jp

# 时间显示时区，默认 Asia/Tokyo
TIMEZONE=Asia/Tokyo

# /push 命令是否仅管理员可用，默认 true
REQUIRE_ADMIN=true

# ===== 语音 TTS + AI 中日互译 =====

# bot 作者 Discord 用户 ID（必填，唯一能使用 /tts 命令的人）
BOT_OWNER_ID=

# OpenAI 兼容接口地址（默认 DeepSeek；可换成 Moonshot/OpenAI 等兼容服务）
AI_BASE_URL=https://api.deepseek.com/v1

# AI 翻译/语种识别 key（必填）
AI_API_KEY=

# AI 模型名，默认 deepseek-chat
AI_MODEL=deepseek-chat

# TTS 音色（Edge TTS，免费）：中文 / 日文
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
TTS_VOICE_JA=ja-JP-NanamiNeural

