# ===== LiveBoost 配置模板 =====

# Discord 机器人令牌。此项为必填配置。
# 配置地址：https://discord.com/developers/applications
DISCORD_TOKEN=你的bot_token

# 命令注册目标服务器 ID；填了则只注册到该服务器，留空注册为全局命令
GUILD_ID=

# 无活动时的检测间隔，单位为分钟，默认值为 2。
CHECK_INTERVAL_MINUTES=2

# 是否启用时速推送，默认 true
HOURLY_PUSH_ENABLED=true

# Bestdori 服务器，默认 jp
BESTDORI_SERVER=jp

# 时间显示时区，默认 Asia/Tokyo
TIMEZONE=Asia/Tokyo

# /push 命令是否仅管理员可用，默认 true
REQUIRE_ADMIN=true

# state.json 路径。默认写入项目根目录。
# Docker 部署时可设置为卷挂载目录，例如 /data/state.json。
STATE_FILE=

# ===== Health HTTP 端口 =====
# 可选配置。填写后开启 HTTP health 端口，供 uptime 等服务进行探活。
HEALTH_PORT=
# 默认只监听本机；需要被其他机器访问时改为 0.0.0.0，并务必设置 HEALTH_TOKEN
HEALTH_BIND=127.0.0.1
# 访问 /health 的 Bearer Token；建议设置一个随机字符串
HEALTH_TOKEN=
# 可选配置 TLS 证书和私钥路径。两项都填写后使用 HTTPS 提供 health 服务。
HEALTH_TLS_CERT=
HEALTH_TLS_KEY=

# ===== 语音 TTS + AI 中日互译 =====

# bot 拥有者的 Discord 用户 ID。此项为必填配置。
BOT_OWNER_ID=

# OpenAI 兼容接口地址。默认使用 DeepSeek，也可改用其他兼容服务。
AI_BASE_URL=https://api.deepseek.com/v1

# AI 翻译和语种识别所用的密钥。此项为必填配置。
AI_API_KEY=

# AI 模型名，默认 deepseek-v4-flash
AI_MODEL=deepseek-v4-flash

# AI 推理力度。none 表示关闭思考，low、medium、high 依次增强。
# 留空时不传递该参数。使用不支持 reasoning_effort 的服务时必须留空。
AI_REASONING_EFFORT=none

# TTS 音色使用 Edge TTS。分别配置中文和日文音色。
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
TTS_VOICE_JA=ja-JP-NanamiNeural

# TTS 语速使用 SSML rate 格式。+25% 表示加快 25%，-10% 表示放慢 10%。
# 中文和日文可以分别设置。只设置 TTS_RATE 时，两种语言共用该值。
TTS_RATE_ZH=+20%
TTS_RATE_JA=+0%
# 旧版统一语速配置。仅在未设置语言专用配置时使用。
TTS_RATE=+25%

# 最多同时并行服务的服务器数，默认值为 3。
# 超过限制后拒绝新的服务器加入。
MAX_VOICE_GUILDS=3

# 独立 AI 互译最多同时启用的文本频道数，默认值为 10。
# 超过限制后拒绝新的绑定。此功能不依赖语音频道。
MAX_TRANSLATE_CHANNELS=10
